{
  "name": "@ahm3tj4f/pi-undo",
  "version": "0.4.0",
  "description": "Undo/redo for pi, but this time it works. Per-message snapshots, ported from OpenCode's exact undo/redo philosophy.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "undo",
    "redo",
    "snapshots",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahm3tj4f/pi-undo.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --import ./test/setup.ts test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
